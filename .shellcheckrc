# shellcheck configuration for firstmate.
#
# CI runs `shellcheck bin/*.sh tests/*.sh` bare, so ANY finding fails the job -
# including info- and style-level ones. The codes below are disabled because they
# fire on idioms this repo uses deliberately, not because they are inconvenient.
# Anything that flags a real defect stays enabled and gets fixed instead.

# `VAR= \` on a continued line deliberately passes an EMPTY value to one command
# (e.g. FM_BOARD_DIR= FM_BOARD_OUT= bin/fm-board.sh --once). Reads as a stray space.
disable=SC1007

# Single quotes are intentional wherever a script emits shell/PowerShell source,
# heredoc bodies, or awk programs that must expand at RUN time, not at write time.
disable=SC2016

# `A && B || C` is used as a terse guard where C running after a true A is either
# impossible or harmless. Rewriting these as if-then-else would not make them safer.
disable=SC2015

# `$((...))` arithmetic reads more clearly with the sigil kept; purely cosmetic.
disable=SC2004

# `ls` over directories this repo creates itself, where filenames are known-safe.
disable=SC2012

# Exporting inside a subshell is the point in these tests - the override is scoped
# to that subshell on purpose and must NOT leak to the parent.
disable=SC2031

# NOT disabled, deliberately:
#   SC2318 - `local a=$1 b="$a/x"` only works when a caller happens to have a
#            variable of the same name in scope (bash is dynamically scoped).
#            It reads as correct and breaks silently when a caller renames a
#            variable. Two `local`s cost nothing; the trap is real.
